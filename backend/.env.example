DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/llm_observability
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local dev runs over plain HTTP - a Secure cookie would never reach the
# backend. Leave this at the default (true) for any real deployment.
COOKIE_SECURE=false
